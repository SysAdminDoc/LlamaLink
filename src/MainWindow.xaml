<Window x:Class="LlamaLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LlamaLink" Width="1300" Height="900"
        Background="{StaticResource BaseBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="/llamalink.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="340" MinWidth="280" MaxWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Left Sidebar ═══ -->
        <Border Grid.Column="0" Background="{StaticResource MantleBrush}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <Border Grid.Row="0" Padding="16,14,16,10">
                    <DockPanel>
                        <Button x:Name="ToggleSidebarBtn" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource GhostButton}" DockPanel.Dock="Right" FontSize="14"
                                Click="ToggleSidebar_Click" ToolTip="Toggle sidebar"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LlamaLink" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource LavenderBrush}"/>
                            <TextBlock Text=" v0.4.0" FontSize="11" Foreground="{StaticResource Overlay0Brush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Sidebar content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                    <StackPanel>
                        <!-- ── Server ── -->
                        <GroupBox Header="Server">
                            <StackPanel>
                                <CheckBox x:Name="ManagedCheck" Content="Launch server locally" IsChecked="True"
                                          Checked="ManagedCheck_Changed" Unchecked="ManagedCheck_Changed"/>

                                <DockPanel x:Name="ExeRow" Margin="0,8,0,0">
                                    <Button Content="..." DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Click="BrowseExe_Click" Padding="10,5" ToolTip="Browse for llama-server.exe"/>
                                    <TextBox x:Name="ExePathBox" VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <DockPanel x:Name="ExtUrlRow" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBox x:Name="ExtUrlBox" Text="http://127.0.0.1:8080" VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <DockPanel x:Name="ExtBackendRow" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Label Content="Backend" Width="54"/>
                                    <ComboBox x:Name="BackendCombo" SelectionChanged="Backend_Changed" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="OpenAI-compatible" Tag="openai" IsSelected="True"/>
                                        <ComboBoxItem Content="Ollama" Tag="ollama"/>
                                        <ComboBoxItem Content="KoboldCpp" Tag="koboldcpp"/>
                                        <ComboBoxItem Content="text-generation-webui" Tag="textgen"/>
                                    </ComboBox>
                                </DockPanel>

                                <DockPanel x:Name="ExtModelRow" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Label Content="Model" Width="54"/>
                                    <TextBox x:Name="ExtModelBox" Text="llama3.2" VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="PortRow" Orientation="Horizontal">
                                        <Label Content="Port"/>
                                        <TextBox x:Name="PortBox" Text="8080" Width="60" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="StartBtn" Content="Start" Style="{StaticResource GreenButton}"
                                                Click="StartServer_Click" Padding="14,5"/>
                                        <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource MauveButton}"
                                                Click="ConnectExternal_Click" Padding="14,5" Visibility="Collapsed"/>
                                        <Button x:Name="StopBtn" Content="Stop" Style="{StaticResource RedButton}"
                                                Click="StopServer_Click" Margin="6,0,0,0" IsEnabled="False" Padding="14,5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Status pill -->
                                <Border Margin="0,8,0,0" Padding="8,4" CornerRadius="10"
                                        HorizontalAlignment="Left" Background="{StaticResource CrustBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ServerDot" Width="8" Height="8" Margin="0,0,6,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{StaticResource CatRed}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock x:Name="ServerStatusLabel" Text="Stopped" FontSize="11"
                                                   Foreground="{StaticResource Subtext0Brush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── llama-server updater ── -->
                        <GroupBox x:Name="ServerUpdateGroup" Header="llama-server updates">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CheckServerUpdateBtn" Content="Check" DockPanel.Dock="Right"
                                            Style="{StaticResource GhostButton}" Click="CheckServerUpdates_Click" Padding="8,4"/>
                                    <TextBlock x:Name="ServerVersionLabel" Text="Local version not checked"
                                               Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ComboBox x:Name="ServerUpdateAssetCombo" DisplayMemberPath="DisplayName"
                                          Margin="0,6,0,0" ToolTip="Compatible Windows x64 release asset"
                                          SelectionChanged="ServerUpdateAsset_Changed"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="DownloadServerUpdateBtn" Content="Download" Style="{StaticResource GreenButton}"
                                            Click="DownloadServerUpdate_Click" Padding="10,4" IsEnabled="False"/>
                                    <Button x:Name="CancelServerUpdateBtn" Content="Cancel" Style="{StaticResource RedButton}"
                                            Click="CancelServerUpdate_Click" Padding="10,4" Margin="6,0,0,0" Visibility="Collapsed"/>
                                </DockPanel>
                                <ProgressBar x:Name="ServerUpdateProgress" Height="5" Margin="0,6,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="ServerUpdateStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Check for a compatible llama.cpp build."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Model ── -->
                        <GroupBox x:Name="ModelGroup" Header="Model">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="..." DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Click="BrowseModelFolder_Click" Padding="10,5" ToolTip="Browse for model folder"/>
                                    <TextBox x:Name="ModelFolderBox" TextChanged="ModelFolder_Changed" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <ComboBox x:Name="ModelCombo" Margin="0,6,0,0" SelectionChanged="ModelCombo_Changed"/>
                                <TextBlock x:Name="ModelInfoLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" Margin="2,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Auto-quant recommendation ── -->
                        <GroupBox Header="Auto-quant recommendation">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Label Content="VRAM (GB)" ToolTip="Available GPU memory"/>
                                <TextBox x:Name="VramBox" Text="8" Grid.Column="1" Margin="8,2" VerticalContentAlignment="Center"/>
                                <Label Content="RAM (GB)" Grid.Row="1" ToolTip="Available system memory for CPU offload"/>
                                <TextBox x:Name="RamBox" Text="16" Grid.Row="1" Grid.Column="1" Margin="8,2" VerticalContentAlignment="Center"/>
                                <Button x:Name="RecommendQuantBtn" Content="Recommend" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                        Click="RecommendQuant_Click" Style="{StaticResource GhostButton}" Padding="8,4"/>
                                <TextBlock x:Name="QuantRecommendationLabel" Grid.Row="2" Grid.ColumnSpan="3"
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="11" TextWrapping="Wrap"
                                           Margin="2,6,0,0" Text="Select a model to compare its local quant variants."/>
                            </Grid>
                        </GroupBox>

                        <!-- ── Server Params ── -->
                        <GroupBox x:Name="ServerParamsGroup" Header="Server Parameters">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Label Content="Context" ToolTip="Context window size in tokens"/>
                                <TextBox x:Name="CtxBox" Text="4096" Grid.Column="1" Margin="8,2" VerticalContentAlignment="Center"/>
                                <Label Content="GPU Layers" Grid.Row="1" ToolTip="Number of layers to offload to GPU"/>
                                <TextBox x:Name="GpuBox" Text="99" Grid.Row="1" Grid.Column="1" Margin="8,2" VerticalContentAlignment="Center"/>
                                <Label Content="Threads" Grid.Row="2" ToolTip="CPU threads for inference"/>
                                <TextBox x:Name="ThreadsBox" Text="4" Grid.Row="2" Grid.Column="1" Margin="8,2" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="FlashAttnCheck" Content="Flash Attention" IsChecked="True" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0"/>
                                <CheckBox x:Name="MlockCheck" Content="Memory Lock" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="SpeculativeGroup" Header="Speculative decoding">
                            <StackPanel>
                                <CheckBox x:Name="SpeculativeCheck" Content="Use a draft model"
                                          Margin="0,0,0,5"/>
                                <DockPanel>
                                    <Button Content="..." DockPanel.Dock="Right" Click="BrowseDraftModel_Click"
                                            Padding="10,5" Margin="6,0,0,0" ToolTip="Choose a draft GGUF model"/>
                                    <TextBox x:Name="DraftModelBox" VerticalContentAlignment="Center"
                                             ToolTip="llama.cpp -md/--model-draft path"/>
                                </DockPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Draft GPU layers" FontSize="11"/>
                                        <TextBox x:Name="DraftGpuLayersBox" Text="99" Margin="0,2,4,0"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Draft context" FontSize="11"/>
                                        <TextBox x:Name="DraftContextBox" Text="512" Margin="4,2,0,0"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SpeculativeStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Optional: the draft model proposes tokens for the main model to verify."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Server profiles ── -->
                        <GroupBox x:Name="ProfileGroup" Header="Server profiles">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="Save" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Click="SaveProfile_Click" Padding="8,4"/>
                                    <TextBox x:Name="ProfileNameBox" Text="Default" VerticalContentAlignment="Center"
                                             ToolTip="Name for the saved server configuration"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="Delete" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource RedBrush}" Click="DeleteProfile_Click" Padding="8,4"/>
                                    <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name"
                                              SelectionChanged="ProfileCombo_Changed" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="ProfileStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Save the current model and server settings as a reusable profile."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Generation ── -->
                        <GroupBox Header="Generation">
                            <StackPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock x:Name="TempLabel" Text="0.70" Width="32" DockPanel.Dock="Right"
                                               Foreground="{StaticResource LavenderBrush}" FontWeight="SemiBold"
                                               TextAlignment="Right" FontSize="12"/>
                                    <Label Content="Temperature"/>
                                    <Slider x:Name="TempSlider" Minimum="0" Maximum="200" Value="70"
                                            ValueChanged="TempSlider_Changed" Margin="8,0,6,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,6">
                                    <TextBlock x:Name="TopPLabel" Text="0.90" Width="32" DockPanel.Dock="Right"
                                               Foreground="{StaticResource LavenderBrush}" FontWeight="SemiBold"
                                               TextAlignment="Right" FontSize="12"/>
                                    <Label Content="Top P"/>
                                    <Slider x:Name="TopPSlider" Minimum="0" Maximum="100" Value="90"
                                            ValueChanged="TopPSlider_Changed" Margin="8,0,6,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock x:Name="RepLabel" Text="1.10" Width="32" DockPanel.Dock="Right"
                                               Foreground="{StaticResource LavenderBrush}" FontWeight="SemiBold"
                                               TextAlignment="Right" FontSize="12"/>
                                    <Label Content="Repeat Penalty"/>
                                    <Slider x:Name="RepSlider" Minimum="100" Maximum="200" Value="110"
                                            ValueChanged="RepSlider_Changed" Margin="8,0,6,0"/>
                                </DockPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition Height="4"/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <Label Content="Top K" FontSize="11"/>
                                        <TextBox x:Name="TopKBox" Text="40" Margin="0,2,4,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Max Tokens" FontSize="11"/>
                                        <TextBox x:Name="MaxTokensBox" Text="2048" Margin="4,2,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                        <Label Content="Preset" FontSize="11"/>
                                        <ComboBox x:Name="PresetCombo" Margin="0,2,0,0" SelectionChanged="Preset_Changed">
                                            <ComboBoxItem Content="Default" IsSelected="True"/>
                                            <ComboBoxItem Content="Creative"/>
                                            <ComboBoxItem Content="Precise"/>
                                            <ComboBoxItem Content="Code"/>
                                            <ComboBoxItem Content="Roleplay"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <Button Content="Load template" Click="LoadGrammarTemplate_Click"
                                            Style="{StaticResource GhostButton}" Padding="8,4" DockPanel.Dock="Right"/>
                                    <Label Content="Output" Width="50" FontSize="11"/>
                                    <ComboBox x:Name="GrammarModeCombo" SelectionChanged="GrammarMode_Changed"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Unconstrained" Tag="None" IsSelected="True"/>
                                        <ComboBoxItem Content="JSON" Tag="Json"/>
                                        <ComboBoxItem Content="Regex starter" Tag="Regex"/>
                                        <ComboBoxItem Content="Code only" Tag="CodeOnly"/>
                                        <ComboBoxItem Content="Custom GBNF" Tag="Custom"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBox x:Name="GrammarEditorBox" Height="74" Margin="0,5,0,0"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="10" ToolTip="llama.cpp GBNF grammar"/>
                                <Expander Header="Visual rule builder" Margin="0,6,0,0">
                                    <StackPanel Margin="0,5,0,0">
                                        <DockPanel>
                                            <Label Content="Name" Width="44" FontSize="11"/>
                                            <TextBox x:Name="GrammarRuleNameBox" Text="root" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <TextBox x:Name="GrammarRuleDefinitionBox" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="42" Margin="0,4,0,0"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"
                                                 ToolTip="GBNF right-hand side, for example: value"/>
                                        <ListBox x:Name="GrammarRuleList" Height="76" Margin="0,5,0,0"
                                                 DisplayMemberPath="Display" SelectionChanged="GrammarRule_Selected"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button Content="Add / update" Click="AddGrammarRule_Click"
                                                    Style="{StaticResource GhostButton}" Padding="8,4"/>
                                            <Button Content="Remove" Click="RemoveGrammarRule_Click"
                                                    Style="{StaticResource GhostButton}" Padding="8,4" Margin="4,0,0,0"/>
                                            <Button Content="Load from GBNF" Click="LoadGrammarRules_Click"
                                                    Style="{StaticResource GhostButton}" Padding="8,4" Margin="4,0,0,0"/>
                                            <Button Content="Apply to editor" Click="ApplyGrammarRules_Click"
                                                    Style="{StaticResource GreenButton}" Padding="8,4" Margin="4,0,0,0"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="GrammarBuilderStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="2,4,0,0"
                                                   Text="Load the editor text to start building named rules."/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="GrammarStatusLabel" Text="No output constraint is sent."
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox x:Name="TokenProbabilitiesCheck" Content="Collect token alternatives"
                                          Margin="0,10,0,0" Foreground="{StaticResource TextBrush}"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Label Content="Top-K" Width="50" FontSize="11"/>
                                    <TextBox x:Name="TokenProbabilitiesKBox" Text="5" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="TokenProbabilityStatusLabel" Text="Token probabilities are disabled."
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ListBox x:Name="TokenProbabilityList" Height="150" Margin="0,5,0,0"
                                         Background="{StaticResource CrustBrush}"
                                         BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                                         Padding="2" FontFamily="Consolas" FontSize="10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}" Margin="2,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Prompt inspector">
                            <StackPanel>
                                <TextBlock Text="Preview the exact request body, role transcript, or an approximate tokenization."
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <DockPanel>
                                    <Button Content="Refresh" Click="InspectPrompt_Click"
                                            Style="{StaticResource GhostButton}" Padding="9,4" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="PromptInspectorViewCombo" SelectionChanged="PromptInspectorView_Changed"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Request JSON" Tag="payload" IsSelected="True"/>
                                        <ComboBoxItem Content="Applied transcript" Tag="transcript"/>
                                        <ComboBoxItem Content="Token preview" Tag="tokens"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="PromptInspectorTemplateLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="2,5,0,0"
                                           Text="The server applies the selected model chat template."/>
                                <TextBlock x:Name="PromptInspectorTokenLabel" Foreground="{StaticResource PeachBrush}"
                                           FontSize="10" Margin="2,3,0,0" Text="No prompt inspected yet."/>
                                <TextBox x:Name="PromptInspectorBox" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" Height="190" Margin="0,5,0,0"
                                         Padding="6" FontFamily="Consolas" FontSize="10"
                                         Text="Click Refresh to inspect the current prompt."/>
                                <TextBlock x:Name="PromptInspectorStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="2,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Speech (optional local tools)">
                            <StackPanel>
                                <TextBlock Text="Hold Record to capture a 16 kHz mono WAV, then transcribe with whisper.cpp."
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <DockPanel Margin="0,2,0,0">
                                    <Label Content="ffmpeg" Width="56"/>
                                    <TextBox x:Name="SpeechFfmpegBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Whisper" Width="56"/>
                                    <TextBox x:Name="SpeechWhisperBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Model" Width="56"/>
                                    <TextBox x:Name="SpeechWhisperModelBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Piper" Width="56"/>
                                    <TextBox x:Name="SpeechPiperBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Voice" Width="56"/>
                                    <TextBox x:Name="SpeechPiperVoiceBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Mic" Width="56"/>
                                    <TextBox x:Name="SpeechMicBox" Text="default" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button x:Name="SpeechRecordBtn" Content="Hold to record" Style="{StaticResource MauveButton}"
                                            PreviewMouseLeftButtonDown="SpeechRecord_MouseDown"
                                            PreviewMouseLeftButtonUp="SpeechRecord_MouseUp" Padding="10,5"/>
                                    <Button x:Name="SpeechStopBtn" Content="Stop" Style="{StaticResource RedButton}"
                                            Click="SpeechStop_Click" Padding="10,5" Margin="5,0,0,0" IsEnabled="False"/>
                                    <Button Content="Make reply WAV" Style="{StaticResource GhostButton}"
                                            Click="SpeechSynthesize_Click" Padding="10,5" Margin="5,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SpeechStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Speech tools are optional and never invoked automatically."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Image generation (optional sd.cpp)">
                            <StackPanel>
                                <CheckBox x:Name="ImageGenEnabledCheck" Content="Enable /image commands"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Label Content="CLI" Width="50"/>
                                    <TextBox x:Name="ImageGenExeBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Model" Width="50"/>
                                    <TextBox x:Name="ImageGenModelBox" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Output" Width="50"/>
                                    <TextBox x:Name="ImageGenOutputBox" VerticalContentAlignment="Center"
                                             ToolTip="Generated PNG files are written here"/>
                                </DockPanel>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Steps" FontSize="11"/>
                                        <TextBox x:Name="ImageGenStepsBox" Text="20" VerticalContentAlignment="Center" Margin="0,2,3,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Width" FontSize="11"/>
                                        <TextBox x:Name="ImageGenWidthBox" Text="512" VerticalContentAlignment="Center" Margin="2,2,2,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Height" FontSize="11"/>
                                        <TextBox x:Name="ImageGenHeightBox" Text="512" VerticalContentAlignment="Center" Margin="3,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ImageGenStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Type /image followed by a prompt in the composer."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── System Prompt ── -->
                        <GroupBox Header="System Prompt">
                            <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="60" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>

                        <!-- ── System prompt library ── -->
                        <GroupBox Header="System prompt library">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="Export" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Click="ExportPrompts_Click" Padding="8,4"/>
                                    <ComboBox x:Name="PromptDomainCombo" SelectionChanged="PromptDomain_Changed"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Code" Tag="Code" IsSelected="True"/>
                                        <ComboBoxItem Content="Roleplay" Tag="Roleplay"/>
                                        <ComboBoxItem Content="Summarize" Tag="Summarize"/>
                                        <ComboBoxItem Content="Translate" Tag="Translate"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="Import" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Click="ImportPrompts_Click" Padding="8,4"/>
                                    <ComboBox x:Name="PromptCombo" DisplayMemberPath="Name"
                                              SelectionChanged="Prompt_Changed" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="PromptNameBox" Margin="0,6,0,0" VerticalContentAlignment="Center"
                                         ToolTip="Name for a custom prompt"/>
                                <TextBox x:Name="PromptEditorBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="78" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Edit the selected prompt before applying or saving"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Apply" Style="{StaticResource AccentButton}" Click="ApplyPrompt_Click" Padding="10,4"/>
                                    <Button Content="Save custom" Style="{StaticResource GhostButton}" Click="SavePrompt_Click"
                                            Margin="6,0,0,0" Padding="8,4"/>
                                    <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{StaticResource RedBrush}"
                                            Click="DeletePrompt_Click" Margin="2,0,0,0" Padding="8,4"/>
                                </StackPanel>
                                <TextBlock x:Name="PromptStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Choose a curated prompt or save your own."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Safe tools ── -->
                        <GroupBox Header="Safe tools">
                            <StackPanel>
                                <CheckBox x:Name="ToolsEnabledCheck" Content="Offer tools to the model"
                                          Margin="0,0,0,4"/>
                                <CheckBox x:Name="FileReadToolCheck" Content="Read files beneath root" IsChecked="True"/>
                                <CheckBox x:Name="CalculatorToolCheck" Content="Calculator" IsChecked="True" Margin="0,3,0,0"/>
                                <CheckBox x:Name="PythonToolCheck" Content="Restricted Python expressions" Margin="0,3,0,0"/>
                                <CheckBox x:Name="WebSearchToolCheck" Content="Web search (asks before network access)" Margin="0,3,0,0"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Label Content="Provider" Width="58"/>
                                    <ComboBox x:Name="WebSearchProviderCombo" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" IsSelected="True"/>
                                        <ComboBoxItem Content="SearxNG proxy" Tag="searxng"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="Proxy URL" Width="58"/>
                                    <TextBox x:Name="WebSearchEndpointBox" Text="http://127.0.0.1:8080"
                                             VerticalContentAlignment="Center" ToolTip="Used only for SearxNG proxy searches"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Label Content="Root" Width="38"/>
                                    <TextBox x:Name="ToolRootBox" VerticalContentAlignment="Center"
                                             ToolTip="File reads are confined beneath this directory"/>
                                </DockPanel>
                                <TextBlock x:Name="ToolStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Tool calls always ask for confirmation before execution."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Local RAG">
                            <StackPanel>
                                <CheckBox x:Name="RagEnabledCheck" Content="Inject relevant local excerpts" IsChecked="False"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="..." DockPanel.Dock="Right" Margin="5,0,0,0" Padding="9,5"
                                            Click="RagBrowseFolder_Click" ToolTip="Choose a folder to keep indexed"/>
                                    <TextBox x:Name="RagFolderBox" VerticalContentAlignment="Center"
                                             ToolTip="Folder watcher includes PDF, Markdown, and text files"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button x:Name="RagWatchBtn" Content="Watch folder" Click="RagWatch_Click"
                                            Style="{StaticResource MauveButton}" Padding="10,5"/>
                                    <Button x:Name="RagStopWatchBtn" Content="Stop watching" Click="RagStopWatch_Click"
                                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="5,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                                <ListBox x:Name="RagSourceList" Height="72" Margin="0,6,0,0"
                                         AllowDrop="True" Drop="RagFiles_Drop" PreviewDragOver="RagFiles_DragOver"
                                         ToolTip="Drop .pdf, .md, or .txt files here"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="RagAddBtn" Content="Add files" Click="RagAdd_Click" Style="{StaticResource AccentButton}"
                                            Padding="10,5"/>
                                    <Button x:Name="RagClearBtn" Content="Clear index" Click="RagClear_Click" Style="{StaticResource GhostButton}"
                                            Padding="10,5" Margin="5,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Label Content="Top" Padding="6,5,2,5"/>
                                        <TextBox x:Name="RagTopKBox" Text="4" Width="34" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="RagStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Drop documents here to build a local index."/>
                                <TextBlock Text="Last retrieved excerpts" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" Margin="0,7,0,3"/>
                                <ListBox x:Name="RagRetrievedList" Height="68" DisplayMemberPath="Display"
                                         SelectionChanged="RagRetrieved_Selected"/>
                                <TextBlock x:Name="RagSelectedSourceLabel" Foreground="{StaticResource PeachBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,5,0,2"
                                           Text="No retrieval selected."/>
                                <TextBox x:Name="RagExcerptViewer" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="92" VerticalScrollBarVisibility="Auto"
                                         Padding="6"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Chat History ── -->
                        <GroupBox Header="History">
                            <StackPanel>
                                <ListBox x:Name="HistoryList" Height="110" SelectionChanged="History_Selected"/>
                                <TextBlock Text="Fork from message" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" Margin="0,8,0,3"/>
                                <ComboBox x:Name="ForkMessageCombo" DisplayMemberPath="Content"
                                          VerticalContentAlignment="Center"/>
                                <DockPanel Margin="0,5,0,0">
                                    <Button x:Name="ForkBranchBtn" Content="Fork branch" Click="ForkBranch_Click"
                                            Style="{StaticResource MauveButton}" Padding="10,5"/>
                                    <TextBox x:Name="BranchNameBox" Text="Alternate" Margin="6,0,0,0"
                                             VerticalContentAlignment="Center" ToolTip="Name for the new branch"/>
                                </DockPanel>
                                <TextBlock x:Name="BranchStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Fork a message; the parent chat stays in History."/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Export" Click="ExportChat_Click" Style="{StaticResource GhostButton}"/>
                                    <Button Content="Delete" Click="DeleteChat_Click" Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource RedBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Few-shot editor">
                            <StackPanel>
                                <TextBlock Text="Edit assistant examples to steer later replies."
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <ComboBox x:Name="FewShotTurnCombo" DisplayMemberPath="Display"
                                          SelectionChanged="FewShotTurn_Selected" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="FewShotEditorBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="90" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                         Padding="6"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="ApplyFewShotBtn" Content="Apply turn" Click="ApplyFewShot_Click"
                                            Style="{StaticResource GreenButton}" Padding="10,5" IsEnabled="False"/>
                                    <Button Content="Reload" Click="ReloadFewShot_Click"
                                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="5,0,0,0"/>
                                </DockPanel>
                                <TextBlock x:Name="FewShotStatusLabel" Foreground="{StaticResource Overlay0Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Text="Assistant turns appear here after a response."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar footer / status -->
                <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Surface0Brush}">
                    <TextBlock x:Name="StatusLabel" Text="Configure server and model to begin"
                               Foreground="{StaticResource Overlay0Brush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Splitter ═══ -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                      Background="{StaticResource Surface0Brush}"/>

        <!-- ═══ Main Content ═══ -->
        <TabControl Grid.Column="2" x:Name="MainTabs" Padding="0">
            <!-- ── Chat Tab ── -->
            <TabItem Header="Chat">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat display -->
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <ItemsControl x:Name="ChatMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="14,10" CornerRadius="8"
                                            Background="{Binding Background}"
                                            BorderThickness="0,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding Accent}"
                                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap"
                                                       FontSize="13.5" Foreground="{StaticResource TextBrush}"
                                                       FontFamily="Segoe UI" LineHeight="20"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state overlay -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                   Foreground="{StaticResource Surface1Brush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Start a conversation" FontSize="16" Foreground="{StaticResource Overlay0Brush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Configure your server and model in the sidebar, then type a message below."
                                   FontSize="12" Foreground="{StaticResource Surface2Brush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                    </StackPanel>

                    <!-- Tool confirmation -->
                    <Border x:Name="ToolConfirmationPanel" Grid.Row="1" Margin="12,0,12,8"
                            Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource PeachBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ApproveToolBtn" Content="Allow once" Style="{StaticResource GreenButton}"
                                        Click="ApproveTool_Click" Padding="10,4"/>
                                <Button x:Name="DenyToolBtn" Content="Deny" Style="{StaticResource RedButton}"
                                        Click="DenyTool_Click" Margin="6,0,0,0" Padding="10,4"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Tool confirmation required" Foreground="{StaticResource PeachBrush}"
                                           FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock x:Name="ToolConfirmationLabel" Foreground="{StaticResource TextBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Input area -->
                    <Border Grid.Row="2" Margin="12,0,12,12" Background="{StaticResource MantleBrush}"
                            CornerRadius="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                            Padding="4" AllowDrop="True" Drop="ChatImage_Drop" PreviewDragOver="ChatImage_DragOver">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <WrapPanel x:Name="ImageAttachmentPanel" Grid.Row="0" Margin="8,4,8,0" Visibility="Collapsed"/>

                            <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" FontSize="13.5"
                                     KeyDown="InputBox_KeyDown" Padding="10,8"
                                     VerticalContentAlignment="Top"/>

                            <DockPanel Grid.Row="2" Margin="8,0,4,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock x:Name="SpeedLabel" Foreground="{StaticResource PeachBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TokenCountLabel" Foreground="{StaticResource Overlay0Brush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="StopGenBtn" Content="Stop" Style="{StaticResource RedButton}"
                                            Height="30" Click="StopGen_Click" Visibility="Collapsed" Padding="12,4"/>
                                    <Button x:Name="SendBtn" Style="{StaticResource AccentButton}"
                                            Height="30" Click="Send_Click" Padding="16,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Send" VerticalAlignment="Center"/>
                                            <TextBlock Text=" &#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="New Chat" Click="NewChat_Click" Style="{StaticResource GhostButton}"/>
                                    <Button x:Name="RegenerateBtn" Content="Regenerate" Click="Regenerate_Click"
                                            Style="{StaticResource GhostButton}" IsEnabled="False" Padding="8,4"
                                            ToolTip="Re-roll the last assistant response with the current temperature and top-p"/>
                                    <TextBlock x:Name="ChatContextLabel" Text="New conversation" Foreground="{StaticResource Overlay0Brush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="10,0,6,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                    <Button x:Name="ChatServerActionBtn" Content="Continue here" Click="ChatServerAction_Click"
                                            Style="{StaticResource GhostButton}" IsEnabled="False" Padding="8,4"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Download Models Tab ── -->
            <TabItem Header="Download Models">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search bar -->
                    <Border Background="{StaticResource MantleBrush}" CornerRadius="8" Padding="4">
                        <DockPanel>
                            <Button x:Name="HfSearchBtn" Content="Search" Style="{StaticResource AccentButton}"
                                    DockPanel.Dock="Right" Margin="4,0,0,0" Height="32" Click="HfSearch_Click" Padding="16,4"/>
                            <TextBox x:Name="HfSearchBox" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="HfSearchBox_KeyDown" Background="Transparent" BorderThickness="0"
                                     Padding="8,6"/>
                        </DockPanel>
                    </Border>

                    <!-- Sort row -->
                    <DockPanel Grid.Row="1" Margin="0,8,0,4">
                        <TextBlock x:Name="HfResultCount" DockPanel.Dock="Right"
                                   Foreground="{StaticResource Overlay0Brush}" FontSize="11" VerticalAlignment="Center"/>
                        <Label Content="Sort"/>
                        <ComboBox x:Name="HfSortCombo" Width="160" Margin="6,0,0,0"
                                  SelectionChanged="HfSort_Changed">
                            <ComboBoxItem Content="Most Downloads" Tag="downloads" IsSelected="True"/>
                            <ComboBoxItem Content="Most Likes" Tag="likes"/>
                            <ComboBoxItem Content="Recently Updated" Tag="lastModified"/>
                            <ComboBoxItem Content="Trending" Tag="trending_score"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- Model results grid -->
                    <DataGrid x:Name="HfModelGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserSortColumns="True"
                              SelectionChanged="HfModel_Selected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="Downloads" Binding="{Binding DownloadsDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Likes" Binding="{Binding LikesDisplay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch"
                                  Background="Transparent" Margin="0,4"/>

                    <!-- Files grid -->
                    <DockPanel Grid.Row="4">
                        <TextBlock x:Name="HfFilesLabel" DockPanel.Dock="Top"
                                   Text="Select a model to see GGUF files"
                                   Foreground="{StaticResource Overlay0Brush}" FontSize="12"
                                   FontStyle="Italic" Margin="2,0,0,6"/>
                        <DataGrid x:Name="HfFilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="*"/>
                                <DataGridTextColumn Header="Quant" Binding="{Binding Quant}" Width="90"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GroupBox Grid.Row="5" Header="Model card" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock x:Name="HfModelCardMeta" DockPanel.Dock="Right"
                                           Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HfModelCardTitle" Text="Select a model to view its README"
                                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBox x:Name="HfModelCardBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="8"
                                     FontFamily="Segoe UI" FontSize="12" Text=""/>
                            <TextBlock x:Name="HfModelCardStatusLabel" Grid.Row="2"
                                       Foreground="{StaticResource Overlay0Brush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="2,5,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- Download controls -->
                    <DockPanel Grid.Row="6" Margin="0,8,0,0">
                        <TextBlock x:Name="DlDestLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource Overlay0Brush}" FontSize="11"/>
                        <Button x:Name="DlBtn" Content="Download" Style="{StaticResource GreenButton}"
                                Height="32" Click="HfDownload_Click" Padding="16,4"/>
                        <Button x:Name="DlCancelBtn" Content="Cancel" Style="{StaticResource RedButton}"
                                Height="32" Margin="6,0,0,0" Click="HfCancelDownload_Click" Visibility="Collapsed" Padding="16,4"/>
                    </DockPanel>

                    <ProgressBar x:Name="DlProgress" Grid.Row="7" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="DlStatusLabel" Grid.Row="8" Margin="2,6,0,0"
                               Foreground="{StaticResource Overlay0Brush}" FontSize="11"/>
                </Grid>
            </TabItem>

            <!-- ── Server Log Tab ── -->
            <TabItem Header="Server Log">
                <Border Background="{StaticResource CrustBrush}" Margin="0,4,0,0" CornerRadius="8">
                    <TextBox x:Name="ServerLogBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="Transparent"
                             Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="11.5" BorderThickness="0" Padding="12,10"/>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
